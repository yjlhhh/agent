# 复制为 .env 后填写真实密钥：
#   cp .env.example .env
#
# 适用于本地源码启动后端（连接宿主机上的 Postgres / ES）

# es
ELASTIC_PASSWORD=changeme
ES_PORT=9200
STACK_VERSION=8.11.3
MEM_LIMIT=1073741824
TIMEZONE=Asia/Shanghai

# DeepSeek（对话/Agent）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_CHAT_MODEL=deepseek-chat
# 更快响应用 deepseek-chat；更强推理用 deepseek-reasoner
LLM_REASONER_MODEL=deepseek-reasoner

# 若使用阿里云百炼做 embedding/rerank，可填写；可留空
DASHSCOPE_API_KEY=

# serper（联网搜索）
SERPER_API_KEY=your-serper-api-key

# 中间件连接配置（源码启动时使用）
DATABASE_URL=postgresql://postgres:pg123456@localhost:5432/gsk
ES_URL=https://elastic:changeme@localhost:9200
